{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": "pfl",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/png/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/svg/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "image/svg+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "_comment_svg": "Free vectors are served from /images/svg/ and nowhere else. The identity rewrite below matches first and passes those through; every other .svg request falls to the catch-all and is rewritten to a path that does not exist, so Vercel answers a real 404 status rather than a 200 carrying an error page. Paid vectors are never committed to this repo, so there is nothing outside that directory to expose even by accident. Rewrites are evaluated in order and the first match wins.",
  "rewrites": [
    {
      "source": "/images/svg/:path*",
      "destination": "/images/svg/:path*"
    },
    {
      "source": "/(.*)\\.svg",
      "destination": "/svg-is-not-served-here"
    }
  ],
  "_comment_library": "Reserved for the gated library. /api/* is free for serverless functions; nothing is built there yet. The grid renders from manifest.json, so a gated route can read the same manifest at request time and serve signed URLs without changing markup or CSS."
}
